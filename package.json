{
  "name": "reeco-ai-search",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@reeco/api",
    "dev:admin": "npm run start --workspace=@reeco/admin",
    "dev:client": "npm run start --workspace=@reeco/client",
    "build:shared": "npm run build --workspace=@reeco/shared",
    "build:api": "npm run build --workspace=@reeco/api",
    "build:admin": "npm run build --workspace=@reeco/admin",
    "build:client": "npm run build --workspace=@reeco/client",
    "test:admin": "npm run test --workspace=@reeco/admin -- --watchAll=false --passWithNoTests",
    "test:client": "npm run test --workspace=@reeco/client -- --watchAll=false --passWithNoTests",
    "build": "npm run build:shared && npm run build:api && npm run build:client && npm run build:admin",
    "build:product-master": "node scripts/product-master/build.mjs",
    "validate:product-master": "node scripts/product-master/validate.mjs",
    "build:spec-normalization": "node scripts/spec-normalization/build.mjs",
    "validate:spec-normalization": "node scripts/spec-normalization/validate.mjs",
    "build:semantic-enrichment": "node scripts/semantic-enrichment/build.mjs",
    "validate:semantic-enrichment": "node scripts/semantic-enrichment/validate.mjs",
    "build:search-documents": "node scripts/search-documents/build.mjs",
    "validate:search-documents": "node scripts/search-documents/validate.mjs",
    "supabase:import": "node scripts/supabase/import-data-foundation.mjs",
    "supabase:validate": "node scripts/supabase/import-data-foundation.mjs --validate-only",
    "supabase:dry-run": "node scripts/supabase/import-data-foundation.mjs --dry-run",
    "supabase:test:local": "node scripts/supabase/test-data-foundation-local.mjs",
    "embeddings:test": "npm run build:api && node --test scripts/create-embeddings/*.test.mjs",
    "embeddings:smoke": "npm run build:api && node scripts/create-embeddings/smoke.mjs",
    "embeddings:backfill": "npm run build:api && node scripts/create-embeddings/backfill.mjs",
    "embeddings:validate": "node scripts/create-embeddings/validate.mjs",
    "search:semantic:test": "npm run build:api && node --test scripts/search/semantic-search.test.mjs",
    "search:semantic:smoke": "npm run build:api && node --env-file=apps/api/.env scripts/search/semantic-smoke.mjs",
    "search:hybrid:test": "npm run build:api && node --test scripts/search/hybrid-search.test.mjs",
    "search:hybrid:smoke": "npm run build:api && node --env-file=apps/api/.env scripts/search/hybrid-smoke.mjs",
    "search:public:test": "npm run build:shared && npm run build:api && node --test scripts/search/public-search.test.mjs",
    "search:public:smoke": "npm run build:shared && npm run build:api && node --env-file=apps/api/.env scripts/search/public-search-smoke.mjs",
    "search:technical:test": "npm run build:shared && npm run build:api && node --test scripts/search/technical-match.test.mjs",
    "search:technical:smoke": "npm run build:shared && npm run build:api && node --env-file=apps/api/.env scripts/search/technical-match-smoke.mjs",
    "search:technical-ranking:test": "npm run build:shared && npm run build:api && node --test scripts/search/technical-ranking.test.mjs",
    "search:technical-ranking:smoke": "npm run build:shared && npm run build:api && node --env-file=apps/api/.env scripts/search/technical-ranking-smoke.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supabase": "2.117.0",
    "typescript-eslint": "^8.20.0",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
