NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Prefer the Supabase Session Pooler connection string on IPv4-only networks.
DATABASE_URL=

AI_RERANK_API_KEY=
AI_LLM_API_KEY=

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=ollama-qwen3-embedding-4b-1536-v1
OLLAMA_EMBEDDING_TIMEOUT_MS=180000
EMBEDDING_BATCH_SIZE=8
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://127.0.0.1:8011
RERANKER_TIMEOUT_MS=350
RERANKER_TOP_N=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
LLM_EXPLANATION_ENABLED=false
LLM_MODEL=
LLM_EXPLANATION_TIMEOUT_MS=20000

SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_SEMANTIC_WEIGHT=0.6
SEARCH_RETRIEVAL_LIMIT=20
SEARCH_RRF_K=60
SEARCH_RESULT_LIMIT=5

# VNPay sandbox (https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html)
# Get TMN code + hash secret from the sandbox merchant email. Never commit real values.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
