# Dev port for @reeco/client (CRA)
# Must NOT conflict with API (3000) or apps/admin (5174)
PORT=5173

# NestJS backend API base URL
# REACT_APP_* prefix is required for CRA browser runtime
REACT_APP_API_URL=http://localhost:3000/api/v1

DISABLE_ESLINT_PLUGIN=true


# UI/UX without Ollama/LLM: serve /search from captured fixtures.
# Set per machine in .env.local (gitignored); leave false if you run the AI stack.
# Special queries: !empty, !error, !unavailable, !invalid, !slow
REACT_APP_SEARCH_MOCK=false
REACT_APP_SEARCH_MOCK_DELAY_MS=600
