          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branches" value="NHÁNH RIÊNG:&#10;• Hỏi explanation có context: đọc model đã chọn, không rerun hybrid.&#10;• Nhu cầu nhiều thành phần: chia nhóm / search con hoặc hỏi làm rõ.&#10;Không suy ra tương thích toàn hệ thống." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;rounded=0;dashed=1;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="420" height="205" as="geometry" />
        </mxCell>
        <mxCell id="unknown" value="MATCH / MISMATCH / UNKNOWN là kết quả matcher.&#10;UNKNOWN không thành MATCH; public filter có thể loại.&#10;Explanation model đã chọn có thể giữ yêu cầu chưa xác nhận." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;rounded=0;dashed=1;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="860" width="440" height="155" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Nguồn: search.service.ts; hybrid-search.service.ts; search-score.service.ts; technical-*.ts; reranker.service.ts.&#10;Phạm vi: Không tiêm sản phẩm ngoài retrieved union. Technical/rerank không viết lại RRF score; scores.rerank public vẫn null." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;fontColor=#334155;fontSize=12;fontStyle=0;spacing=0;" vertex="1" parent="1">
