        <mxCell id="hydrate" value="Hydrate active + giá; scope exact identity; limit&#10;explain=true → evidence / optional LLM&#10;SearchResponse + guidance khi cần" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
