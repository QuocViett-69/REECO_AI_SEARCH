        <mxCell id="pay" value="payment_status là trường riêng:&#10;PENDING_PAYMENT · COD_PENDING · PAID · FAILED&#10;COD chuyển DELIVERED → đánh dấu PAID.&#10;PAID (status) vẫn tồn tại trong luồng admin." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;rounded=0;dashed=1;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
