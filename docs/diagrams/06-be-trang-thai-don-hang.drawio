        <mxCell id="cancel" value="Khách chỉ tự hủy khi status thuộc:&#10;PENDING_PAYMENT, PAYMENT_FAILED, PAID, PROCESSING.&#10;Admin có tập transition hủy rộng hơn. Không suy ra hoàn tiền tự động." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;rounded=0;dashed=1;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
