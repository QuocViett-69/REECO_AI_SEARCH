        <mxCell id="footer" value="Nguồn: orders.constants.ts; OrdersService.cancelOrder / updateOrderStatusByAdmin; VNPayService; orders.repository.ts.&#10;Phạm vi: DELIVERED và CANCELLED là trạng thái không có transition tiếp theo trong map admin. Sơ đồ không mô tả refund." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;fontColor=#334155;fontSize=12;fontStyle=0;spacing=0;" vertex="1" parent="1">
