        </mxCell>
        <mxCell id="import" value="7. Import Supabase&#10;Transaction / idempotency&#10;Text đổi → xóa vector cũ" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
