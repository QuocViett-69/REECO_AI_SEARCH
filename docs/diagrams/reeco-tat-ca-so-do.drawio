          <mxGeometry x="470" y="200" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="3. Normalize specification&#10;number / range / protocol / text&#10;Giữ value_raw + raw_ref" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
